# ==============================================================================
# J.A.R.V.I.S. Local Configuration Defaults
# Fully local, secure, low-latency autonomous AI agent
# ==============================================================================

# Local Model Runtime (Ollama Loopback)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b
# Bounded context window to prevent excessive unified memory allocation on Apple Silicon
LLM_NUM_CTX=2048
LLM_TEMPERATURE=0.3
VISION_MODEL=qwen3.5:4b

# Agent Runtime Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Audio Configuration
SAMPLE_RATE=24000
AUDIO_PLAYBACK_DEVICE=default

# Browser Automation (Chrome DevTools Protocol - Loopback only)
CDP_HOST=127.0.0.1
CDP_PORT=9222
CDP_TIMEOUT_SEC=5.0
